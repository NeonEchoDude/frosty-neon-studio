# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
# Written by the VRWorldToolkit package during SDK builds (build reports and its own settings)
/[Aa]ssets/_LastBuild/
/[Aa]ssets/_LastBuild.meta
/[Aa]ssets/VRWorldToolkit/
/[Aa]ssets/VRWorldToolkit.meta

# Owner-supplied test avatars from other creators: keep out of Git
/[Aa]ssets/FrostyNeon/TestAvatars/
# VRoid files people bring in with the Avatar Guide or frosty.ps1 vroid (their own avatars, not toolkit files)
/[Aa]ssets/FrostyNeon/VRoid/
/[Aa]ssets/FrostyNeon/VRoid.meta
# Model files (.fbx) people bring in with Frosty Neon Studio or frosty.ps1 model
/[Aa]ssets/FrostyNeon/Models/
/[Aa]ssets/FrostyNeon/Models.meta
# Avatars exported from Blender with frosty.ps1 export/all are copied beside the starter robot; keep them (and the
# materials and Quest versions made for them) out of Git. Only the robot's own files are tracked.
/[Aa]ssets/FrostyNeon/Avatars/*
!/[Aa]ssets/FrostyNeon/Avatars/FrostyNeonBot.fbx
!/[Aa]ssets/FrostyNeon/Avatars/FrostyNeonBot.fbx.meta
!/[Aa]ssets/FrostyNeon/Avatars/FrostyNeonBot_Avatar.prefab
!/[Aa]ssets/FrostyNeon/Avatars/FrostyNeonBot_Avatar.prefab.meta
!/[Aa]ssets/FrostyNeon/Avatars/Materials/
!/[Aa]ssets/FrostyNeon/Avatars/Materials.meta
/[Aa]ssets/FrostyNeon/Avatars/Materials/*
!/[Aa]ssets/FrostyNeon/Avatars/Materials/Frosty Cyan.mat
!/[Aa]ssets/FrostyNeon/Avatars/Materials/Frosty Cyan.mat.meta
!/[Aa]ssets/FrostyNeon/Avatars/Materials/Midnight Navy.mat
!/[Aa]ssets/FrostyNeon/Avatars/Materials/Midnight Navy.mat.meta
/[Aa]ssets/FrostyNeon/TestAvatars.meta
