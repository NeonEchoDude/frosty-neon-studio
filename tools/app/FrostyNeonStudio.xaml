<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frosty Neon Studio" Width="1180" Height="820" MinWidth="900" MinHeight="600"
        Background="#0D0F1E" Foreground="#E8ECFF" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <!-- Colours (text contrast is checked by the self-test against WCAG AA, 4.5:1):
       page #0D0F1E, card #181B35, inset #11142A, text #E8ECFF, dim text #A8B0E0, cyan #3EF2FF, pink #FF4FD8,
       section titles #B49CFF, quiet button #2A2F5A. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#181B35"/>
    <SolidColorBrush x:Key="Inset" Color="#11142A"/>
    <SolidColorBrush x:Key="Cyan" Color="#3EF2FF"/>
    <SolidColorBrush x:Key="Pink" Color="#FF4FD8"/>
    <SolidColorBrush x:Key="Violet" Color="#B49CFF"/>
    <SolidColorBrush x:Key="Dim" Color="#A8B0E0"/>

    <!-- Buttons: Neon (pink) = the main step, NeonAlt (cyan) = the Quest step, Quiet = everything else. -->
    <Style x:Key="Neon" TargetType="Button">
      <Setter Property="Foreground" Value="#0D0F1E"/>
      <Setter Property="Background" Value="#FF4FD8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                    BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NeonAlt" TargetType="Button" BasedOn="{StaticResource Neon}">
      <Setter Property="Background" Value="#3EF2FF"/>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Neon}">
      <Setter Property="Background" Value="#2A2F5A"/>
      <Setter Property="Foreground" Value="#E8ECFF"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Quiet}">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="#3EF2FF"/>
      <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
    </Style>
    <!-- The avatar list: dark when it is switched off during a step, too (Windows would paint it white). -->
    <Style x:Key="AvatarListStyle" TargetType="ListBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border x:Name="frame" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Avatar list rows: readable selection colours whether or not the list has the focus. -->
    <Style x:Key="AvatarRow" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#E8ECFF"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"
                    BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#20244A"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="#2E3470"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="#3EF2FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="0.22*" MinHeight="72" MaxHeight="150"/>
    </Grid.RowDefinitions>

    <!-- Banner -->
    <Border Grid.Row="0" CornerRadius="10" Padding="18,10" Margin="0,0,0,12">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#2A0F4A" Offset="0"/>
          <GradientStop Color="#0F2A4A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="FROSTY NEON STUDIO" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
          <TextBlock Text="From your avatar download to VRChat, without learning Unity." Foreground="{StaticResource Pink}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" MaxWidth="380">
          <TextBlock x:Name="BusyText" Text="" Foreground="{StaticResource Cyan}" TextAlignment="Right" HorizontalAlignment="Right"
                     AutomationProperties.Name="What the studio is doing" AutomationProperties.LiveSetting="Polite"/>
          <ProgressBar x:Name="Busy" Width="160" Height="6" Margin="0,5,0,0" HorizontalAlignment="Right" IsIndeterminate="False"
                       Visibility="Hidden" Foreground="#FF4FD8" Background="#2A2F5A" BorderThickness="0"
                       AutomationProperties.Name="Working"/>
        </StackPanel>
        <Button x:Name="MenuButton" Grid.Column="2" Content="M_ore  &#x25BE;" Style="{StaticResource Quiet}" Margin="0" VerticalAlignment="Center"
                ToolTip="Desktop shortcut, logs and details for a helper" AutomationProperties.Name="More options">
          <Button.ContextMenu>
            <ContextMenu x:Name="Menu">
              <MenuItem x:Name="MenuShortcut" Header="Create a _desktop shortcut"/>
              <MenuItem x:Name="MenuCopy" Header="_Copy details for a helper"/>
              <MenuItem x:Name="MenuLogs" Header="_Open the logs folder"/>
              <Separator/>
              <MenuItem x:Name="MenuDoctor" Header="Check this _PC again"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>
    </Border>

    <!-- Something went wrong (or Unity is in the way): what happened and the way forward -->
    <Border x:Name="NoticeBox" Grid.Row="1" Visibility="Collapsed" Background="#3A1428" BorderBrush="#FF5A7A" BorderThickness="0,0,0,0"
            CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="NoticeText" Foreground="#FFE3EA" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="NoticeButton" Content="_Try again" Style="{StaticResource Neon}" Margin="0,0,8,0"/>
          <Button x:Name="NoticeClose" Content="Dismiss" Style="{StaticResource Quiet}" Margin="0" ToolTip="Hide this message"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: setup and avatars -->
      <DockPanel Grid.Column="0" Margin="0,0,12,0">
        <Border DockPanel.Dock="Top" Background="{StaticResource Card}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="1   YOUR PC" FontWeight="Bold" Foreground="{StaticResource Violet}"/>
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,6,0,0">
              <TextBlock x:Name="SetupText" Text="Checking what is installed..." AutomationProperties.Name="Your PC" LineHeight="19"/>
            </ScrollViewer>
            <Button x:Name="SetupAgainButton" Content="_Check again" Style="{StaticResource Quiet}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Visibility="Collapsed" ToolTip="Check what is installed again, after installing something"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14,12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="2   PICK YOUR AVATAR" FontWeight="Bold" Foreground="{StaticResource Violet}"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
              <Button x:Name="AddButton" Content="_Add an avatar file" Style="{StaticResource Neon}"
                      ToolTip="A Booth package (.unitypackage), a VRoid file (.vrm) or a model (.fbx)"/>
              <Button x:Name="RefreshButton" Content="_Refresh" Style="{StaticResource Quiet}" ToolTip="Look for avatars in the project again"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0"
                       Text="Uploads are always private, and nothing goes up until you say so."/>
            <Grid Margin="0,2,0,0">
              <ListBox x:Name="AvatarList" Background="{StaticResource Inset}" Foreground="#E8ECFF" BorderThickness="0" Padding="4"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource AvatarRow}" Style="{StaticResource AvatarListStyle}"
                       AutomationProperties.Name="Your avatars"/>
              <TextBlock x:Name="ListEmpty" Visibility="Collapsed" IsHitTestVisible="False" Margin="14" Foreground="{StaticResource Dim}"
                         VerticalAlignment="Top" Text=""/>
            </Grid>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- Right: the chosen avatar -->
      <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="8" Padding="16,14">
        <Grid>
          <!-- Shown until an avatar is picked -->
          <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="10">
            <TextBlock x:Name="EmptyTitle" Text="Your avatars will show up here" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Cyan}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock x:Name="EmptyText" Margin="0,10,0,0" Foreground="{StaticResource Dim}" TextAlignment="Center" HorizontalAlignment="Center"
                       Text="The studio looks for them as soon as it can. You can also drop an avatar file anywhere on this window."/>
            <Border x:Name="EmptyDrop" Margin="0,18,0,0" BorderBrush="#3EF2FF" BorderThickness="2" CornerRadius="10" Padding="26,20" HorizontalAlignment="Center">
              <Border.Effect><DropShadowEffect Color="#3EF2FF" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
              <TextBlock Text="&#x2193;  drop it here  &#x2193;" FontSize="16" Foreground="{StaticResource Pink}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Margin="0,18,0,0" Foreground="{StaticResource Dim}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center"
                       Text="The check, pictures and buttons appear here. Nothing changes until you say so."/>
          </StackPanel>
          <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
            <StackPanel x:Name="Detail" Margin="0,0,6,0">
              <TextBlock x:Name="AvatarName" Text="" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
              <TextBlock x:Name="Headline" Text="" FontSize="15" Margin="0,4,0,0"/>
              <WrapPanel x:Name="Pills" Margin="0,8,0,0"/>
              <Border x:Name="TermsBox" Visibility="Collapsed" Background="#3A2A10" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                <TextBlock x:Name="TermsText" Foreground="#FFD36E" AutomationProperties.Name="The creator's terms"/>
              </Border>
              <UniformGrid Columns="3" Margin="0,12,0,0" MaxWidth="620" HorizontalAlignment="Left">
                <Image x:Name="Pic1" MaxHeight="200" Margin="0,0,6,0" Stretch="Uniform" AutomationProperties.Name="Front view"/>
                <Image x:Name="Pic2" MaxHeight="200" Margin="3,0,3,0" Stretch="Uniform" AutomationProperties.Name="Side view"/>
                <Image x:Name="Pic3" MaxHeight="200" Margin="6,0,0,0" Stretch="Uniform" AutomationProperties.Name="Back view"/>
              </UniformGrid>
              <TextBlock x:Name="Facts" Text="" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="FixButton" Content="_Fix it for me" Style="{StaticResource Neon}" IsEnabled="False"/>
                <Button x:Name="UndoFixButton" Content="U_ndo the fix" Style="{StaticResource Quiet}" IsEnabled="False"/>
                <Button x:Name="QuestButton" Content="_Make a Quest version" Style="{StaticResource NeonAlt}" IsEnabled="False"/>
                <Button x:Name="QuestLookButton" Content="Show _Quest look" Style="{StaticResource Quiet}" IsEnabled="False"/>
                <Button x:Name="RemoveQuestButton" Content="R_emove the Quest version" Style="{StaticResource Quiet}" IsEnabled="False"/>
              </WrapPanel>
              <WrapPanel>
                <Button x:Name="UploadPcButton" Content="_Upload for PC" Style="{StaticResource Neon}" IsEnabled="False"/>
                <Button x:Name="UploadQuestButton" Content="Up_load for Quest" Style="{StaticResource NeonAlt}" IsEnabled="False"/>
              </WrapPanel>
              <TextBlock x:Name="Findings" Text="" Margin="0,8,0,0" LineHeight="19" AutomationProperties.Name="What the check found"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="DetailsToggle" Content="Show details for _helpers" Style="{StaticResource Small}"
                        ToolTip="The technical side: codes, objects and files. Handy when someone helps you."/>
                <Button x:Name="CopyButton" Content="Cop_y details" Style="{StaticResource Small}"
                        ToolTip="Copy these details and the activity log, to paste into a message to a helper"/>
              </StackPanel>
              <Border x:Name="DetailsFold" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBox x:Name="DetailsText" Background="{StaticResource Inset}" Foreground="#A8B0E0" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="Wrap" Padding="8" AutomationProperties.Name="Details for helpers"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Activity -->
    <Border Grid.Row="3" Background="#090B16" CornerRadius="8" Margin="0,12,0,0" Padding="10,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Dim}" Margin="0,0,0,2"/>
        <TextBox x:Name="Log" Background="Transparent" Foreground="#A8B0E0" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log"/>
      </DockPanel>
    </Border>

    <!-- Shown while a file is dragged over the window -->
    <Border x:Name="DropOverlay" Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="12"
            Background="#E60D0F1E" BorderBrush="#3EF2FF" BorderThickness="3">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="24">
        <TextBlock x:Name="DropText" Text="Drop to add your avatar" FontSize="28" FontWeight="Bold" Foreground="#3EF2FF"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock x:Name="DropHint" Text="" FontSize="15" Foreground="#FF4FD8" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
